# ============================================
# Lumina Chat — Environment Variables
# by AL ASAR JADEED (alasarjadeed.com)
# ============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it's already in .gitignore.

# --- Required: Auth Secret ---
# Generate: openssl rand -base64 32
# Or visit: https://generate-secret.vercel.app/32
AUTH_SECRET=

# --- Required: PostgreSQL Database ---
# Option 1: Vercel Postgres (auto-configured on Vercel)
# Option 2: Neon (free tier): https://neon.tech
# Option 3: Supabase (free tier): https://supabase.com
# Option 4: Local Docker: postgresql://user:password@localhost:5432/dbname
POSTGRES_URL=

# ============================================
# AI Model Providers (bring your own keys)
# At least ONE provider is required.
# ============================================

# --- Remote LLM (DeepSeek — cheap & fast) ---
# Get key at: https://platform.deepseek.com/api_keys
REMOTE_LLM_API_KEY=
REMOTE_LLM_BASE_URL=https://api.deepseek.com/v1
REMOTE_LLM_MODEL=deepseek-chat

# --- Local LLM (Ollama — always free, runs offline) ---
# Requires Ollama installed: https://ollama.ai
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# --- Groq (free tier: 1K req/day, ultra-fast) ---
# Get key at: https://console.groq.com
GROQ_API_KEY=

# --- Google AI Studio / Gemini (free tier: 1.5K req/day) ---
# Get key at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# --- OpenRouter (free tier: 50-1000 req/day, 25+ free models) ---
# Get key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# --- Cerebras (free tier: 1M tokens/day, fastest inference) ---
# Get key at: https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# ============================================
# OAuth Providers (optional — for social login)
# ============================================

# GitHub OAuth: https://github.com/settings/developers
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_ID=
GOOGLE_SECRET=

# ============================================
# Business Identity (optional — shows in chat responses)
# ============================================
BUSINESS_NAME=AL ASAR JADEED
BUSINESS_EMAIL=info@alasarjadeed.com
BUSINESS_PHONE=

# ============================================
# Email (optional — for sendEmail tool)
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# IMAP for receiving email (optional)
IMAP_HOST=
IMAP_USER=
IMAP_PASS=

# ============================================
# WhatsApp Cloud API (optional)
# https://developers.facebook.com/docs/whatsapp
# ============================================
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_FROM=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ============================================
# Twilio Voice Calls (optional)
# ============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ============================================
# Vercel Services (auto-configured on Vercel)
# ============================================
# AI_GATEWAY_API_KEY=
# BLOB_READ_WRITE_TOKEN=
# REDIS_URL=
