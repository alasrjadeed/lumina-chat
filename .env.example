# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# ---- OAuth Providers ----
# GitHub OAuth: https://github.com/settings/developers
GITHUB_ID=****
GITHUB_SECRET=****

# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_ID=****
GOOGLE_SECRET=****

# ---- LLM (optional) ----
# OpenAI-compatible endpoint used as fallback provider. If unset, the app
# falls back to the Vercel AI Gateway (AI_GATEWAY_API_KEY).
USER_LLM_API_KEY=****
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_MODEL=deepseek-chat

# ---- Free Model Providers (no credit card required) ----
# Groq — free 1K req/day, ultra-fast inference
# Get key at: https://console.groq.com
GROQ_API_KEY=****

# Google AI Studio (Gemini) — free 1.5K req/day, 1M context
# Get key at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=****

# OpenRouter — free 50-1000 req/day, 25+ free models
# Get key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=****

# Cerebras — free 1M tokens/day, fastest inference
# Get key at: https://cloud.cerebras.ai
CEREBRAS_API_KEY=****

# ---- Business / Office manager ----
# Business identity (defaults are used when unset).
BUSINESS_NAME=MonkeyCode Digital
BUSINESS_EMAIL=hello@monkeycode.digital
BUSINESS_PHONE=+1 (555) 123-4567

# SMTP for sending email (sendEmail tool / inbound email replies).
SMTP_HOST=****
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=****
SMTP_PASS=****
SMTP_FROM=****

# IMAP for receiving email (optional).
IMAP_HOST=****
IMAP_USER=****
IMAP_PASS=****

# WhatsApp Cloud API (optional). See https://developers.facebook.com/docs/whatsapp
WHATSAPP_TOKEN=****
WHATSAPP_PHONE_NUMBER_ID=****
WHATSAPP_FROM=****
# Verify token for the inbound WhatsApp webhook (hub.verify_token).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=****

# Twilio for outbound voice calls (optional).
TWILIO_ACCOUNT_SID=****
TWILIO_AUTH_TOKEN=****
TWILIO_FROM_NUMBER=****
